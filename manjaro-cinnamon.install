theme=manjaro-cinnamon

post_install() {
  echo ""
  echo "Setting Plymouth theme to ${theme}..."
  echo ""
  plymouth-set-default-theme -R ${theme}
}

post_upgrade() {
  plymouth-set-default-theme -R
}

post_remove() {
  echo ""
  echo "Resetting to default Plymouth theme..."
  echo ""
  plymouth-set-default-theme -r -R
}
